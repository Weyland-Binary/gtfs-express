# GTFS API base URL (adapt to your production domain)
VITE_API_BASE_URL=https://votre-domaine.com/api/gtfs

# Road-routing (OSRM) endpoint used by the shape editor. Defaults to the public
# demo server. Self-hosted example: https://osrm.example.com/route/v1/driving
# The host must also be allowed in security-headers.conf (CSP connect-src).
# VITE_OSRM_URL=https://router.project-osrm.org/route/v1/driving
