# GTFS API base URL (adapt to your production domain)
VITE_API_BASE_URL=https://votre-domaine.com/api/gtfs

# Basemap tiles (src/components/map/basemapConfig.js). Without a key the map
# uses OpenFreeMap (free, no key, vector styles rendered by MapLibre). With a
# key, the provider is inferred (or forced with VITE_BASEMAP_PROVIDER):
#   CARTO    - https://carto.com/basemaps/apikey  (free up to 1M requests/month
#              for commercial use; keyless tiles are watermarked since 2026-09-23)
#   MapTiler - https://cloud.maptiler.com (Flex plan for commercial use; also
#              serves the satellite layer)
# Restrict the key to your domain in the provider console: it ships in the bundle.
# VITE_BASEMAP_PROVIDER=carto|maptiler|openfreemap
# VITE_CARTO_API_KEY=
# VITE_MAPTILER_KEY=
