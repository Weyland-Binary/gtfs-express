{
  "name": "GTFS-EXPRESS-API",
  "version": "1.0.0",
  "description": "GTFS Express — API for parsing, editing and validating GTFS files.",
  "main": "src/app.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "lint": "eslint src",
    "test": "node -e \"console.error('The test suites are kept in the private development repository, not in this one: see README.md, Tests and evaluation.');process.exit(1)\"",
    "test:coverage": "node -e \"console.error('The test suites are kept in the private development repository, not in this one: see README.md, Tests and evaluation.');process.exit(1)\""
  },
  "keywords": [
    "gtfs",
    "api",
    "transport"
  ],
  "author": "Weyland-Binary",
  "license": "AGPL-3.0-only",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/src/__tests__/_helpers/jestEnv.js"
    ]
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0.34.2",
    "@anthropic-ai/sdk": "^0.128.0",
    "@anthropic-ai/vertex-sdk": "0.20.2",
    "@napi-rs/canvas": "^1.0.10",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "body-parser": "^2.4.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.0",
    "express-rate-limit": "^8.7.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "helmet": "^8.3.0",
    "pdfjs-dist": "6.3.289",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "unzipper": "^0.12.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.0"
  }
}
