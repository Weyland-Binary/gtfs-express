# Port du serveur
PORT=3004

# Admin dashboard secret. Required in production. If empty, /admin/* returns 503.
# Use a long random string (e.g. `openssl rand -hex 32`).
ADMIN_TOKEN=

# HMAC secret used to anonymize IP addresses and e-mails in the event logs, and
# to key the sign-in codes and free-trial records the accounts store keeps.
# Required in production: the API aborts at startup if NODE_ENV=production and
# this is left at the default (a fallback to ADMIN_TOKEN exists but should not
# be relied upon). Use a long random string (e.g. `openssl rand -hex 32`).
IP_HASH_SECRET=

# HMAC secret of the browser tokens that own the projects kept without an
# account (the server keeps only the HMAC of a token). Required in production:
# without it the workspace answers 503 WORKSPACE_DISABLED. Distinct from
# ADMIN_TOKEN and IP_HASH_SECRET, and never rotated with them (every anonymous
# project would be orphaned). Generate it with `openssl rand -hex 32`.
CLIENT_TOKEN_SECRET=

# Proxies in front of the API, counted back along X-Forwarded-For for the
# visitor's address (per-IP limits, hashed addresses in the logs). Empty → 1
# (a local run has none or one); production's compose sets 2.
TRUST_PROXY_HOPS=
# Days the API's JSONL logs keep a line, swept daily. Empty → 365; 0 keeps all.
LOG_RETENTION_DAYS=

# CORS : origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting (global / upload / sample loader)
# 3000 req/h leaves headroom for an active editing session: 200+ stop edits
# in a single sitting + a few revalidations are normal for a transit operator
# polishing a feed. Tighten in production via the env var if abuse is observed.
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=3000
RATE_LIMIT_MAX_UPLOADS=20
RATE_LIMIT_SAMPLE_WINDOW_MS=900000
RATE_LIMIT_MAX_SAMPLES=5
# Comparisons of two networks (POST /gtfs/diff) per session a minute; four times that per address. Default 10.
DIFF_RATE_LIMIT_MAX=10

# Gestion des sessions
SESSION_CLEANUP_AGE_MS=7200000
MAX_SESSIONS=50
# Heap (MB) of the child process a feed's import runs in; empty: what the API's heap has free at that moment.
IMPORT_CHILD_HEAP_MB=
# Imports admitted at once, the running one included (one runs, the others wait); beyond, 503 SERVER_BUSY. Default 4.
IMPORT_QUEUE_MAX=4

# Environnement (development | production)
NODE_ENV=development

# 👤 User accounts and the licence (see DEPLOYMENT.md, "User accounts").
# Off by default: /gtfs/auth/* answers 503 ACCOUNTS_DISABLED. Signing in is a
# six-digit code sent by e-mail, no password (the first verified code creates
# the account). Without the paid offer (PAID_ACCESS_ENABLED, off by default:
# the open model) reading and every modification stay open to everyone; with
# accounts on, the direct mode wants a licence (the "studio" right).
# ACCOUNTS_ENABLED=true
# How the sign-in codes and the quote requests are sent. Unset: log outside
# production — the message, code included, is written to the API's output —
# and nothing in production (sign-in then answers 503 MAIL_UNAVAILABLE).
# brevo: Brevo's transactional API, with MAIL_API_KEY and MAIL_FROM (a sender
# Brevo has verified). memory: kept in the process (tests, e2e). Never commit
# a key.
# MAIL_PROVIDER=log
# MAIL_API_KEY=
# MAIL_FROM=no-reply@example.org
# MAIL_FROM_NAME=GTFS Express
# The operator's own addresses, comma-separated: once verified by a sign-in
# code, every right without an end and without a per-account AI cap.
# ADMIN_EMAILS=you@example.org
# The paid offer (needs ACCOUNTS_ENABLED=true): every modification needs an
# account whose licence runs (ADMIN_EMAILS, a subscription, the
# administrator's grant until its optional end date, or the free trial).
# TRIAL_DAYS: the free trial, once per address (default 14; 0: none).
# LICENCE_PRICE_EUR_YEAR: the yearly price, excluding VAT, the offer shows,
# indicative only (default 4900).
# PAID_ACCESS_ENABLED=true
# TRIAL_DAYS=14
# LICENCE_PRICE_EUR_YEAR=4900
# The retired access codes' use log: no longer written, still read by the admin
# statistics until it ages out. Default: `<api>/beta/usage.jsonl`.
# BETA_USAGE_PATH=

# 🤖 NL2SQL — génération de requêtes SQL à partir du langage naturel via
# l'API Anthropic Claude. Ouverte à tous ; un compte sous licence y a ses
# propres plafonds (BETA_NL2SQL_*). Le system prompt contient le schéma
# SQLite des 15 tables GTFS, les contraintes (heures > 24:00:00, FK ON UPDATE CASCADE, ...) et
# les requêtes analytiques préinstallées comme exemples few-shot.
#
# - NL2SQL_ENABLED=true   → endpoint POST /gtfs/sql/nl2sql actif + bouton
#                           "Generate from natural language" affiché côté UI
# - NL2SQL_ENABLED=false  → endpoint renvoie 503, bouton masqué (kill switch)
# - NL2SQL_MODEL          → modèle Claude (défaut claude-haiku-4-5 pour le
#                           coût ; passer claude-sonnet-4-6 ou claude-opus-4-7
#                           pour des requêtes plus complexes)
# - ANTHROPIC_API_KEY     → clé API Anthropic (https://console.anthropic.com)
NL2SQL_ENABLED=true
NL2SQL_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY

# 🌍 Fournisseur du modèle (voir DEPLOYMENT.md, « Model provider »)
# - LLM_PROVIDER vide ou anthropic → l'API directe, ANTHROPIC_API_KEY ci-dessus
# - LLM_PROVIDER=bedrock → Amazon Bedrock dans LLM_AWS_REGION (requis, sans
#                          défaut : eu-west-3 Paris, eu-central-1 Francfort),
#                          identifiants AWS par défaut (variables, profil, rôle)
# - LLM_PROVIDER=vertex  → Google Vertex AI, LLM_VERTEX_PROJECT_ID (requis) et
#                          LLM_VERTEX_REGION (défaut eu), identifiants Google
#                          par défaut de l'application
# Les identifiants de modèle restent ceux ci-dessus (claude-…) : le serveur
# ajoute le préfixe anthropic. que Bedrock attend.
LLM_PROVIDER=
LLM_AWS_REGION=
LLM_VERTEX_PROJECT_ID=
LLM_VERTEX_REGION=

# AI cost guard — three-tier sliding-window limiter (services/aiCostLimiter.js)
# applied to /sql/nl2sql AND /sql/nl2sql-chat. All caps are sliding windows.
#   - NL2SQL_RATE_LIMIT           hourly cap on the one-shot endpoint, without a licence
#   - NL2SQL_CHAT_RATE_LIMIT      hourly cap on the chat endpoint, without a licence
#   - NL2SQL_DAILY_LIMIT_PER_CODE 24h cap shared across both endpoints, without a licence
#   - NL2SQL_DAILY_BUDGET_TOTAL   global 24h kill-switch shared by everyone
# A licensed account has its own key (user:<id>) and the higher BETA_NL2SQL_*
# caps (the names kept from the retired codes); the ADMIN_EMAILS accounts have
# no per-account cap, only the global budget.
# At Claude Haiku ~1¢/req: 100/day = ~1€/day per key; 500 global = ~5€/day max.
NL2SQL_RATE_LIMIT=30
NL2SQL_DAILY_LIMIT_PER_CODE=100
NL2SQL_DAILY_BUDGET_TOTAL=500
# The same server-wide ceiling in money: every model call's estimated cost
# (services/llm/prices.js, AI_USD_PER_EUR) summed over the UTC day; above it the
# AI answers 503 AI_BUDGET_EXHAUSTED until midnight UTC (default 100; 0: off).
# AI_DAILY_BUDGET_EUR_TOTAL=100

# The reading companion, under the paid offer: a signed-in account without the
# licence may ask the reader's assistant READER_AI_QUESTIONS_MONTH questions per
# calendar month (default 20; 0: off, the chat is the licence's), read-only
# tools only, within READER_AI_BUDGET_EUR_MONTH euros a month (default 3).
# READER_AI_QUESTIONS_MONTH=20
# READER_AI_BUDGET_EUR_MONTH=3
