# Staging environment of GTFS Express (deploy/staging). Copy to
# deploy/staging/.env.staging and fill it; never reuse or edit the production
# .env. This file is read only by deploy/staging/up.sh.

# Port of the staging web on 127.0.0.1 (reach it with an SSH tunnel).
STAGING_PORT=18080

# A long random secret, different from production's (grants the studio
# entitlement through /api/gtfs/admin/users/:id/entitlements). Generate it
# with: openssl rand -hex 32
ADMIN_TOKEN=
# Another random secret, for the anonymised IPs of the event logs.
IP_HASH_SECRET=
# A third random secret, for the browser tokens that own the projects kept
# without an account. Never rotate it: those projects would be orphaned.
CLIENT_TOKEN_SECRET=
# One proxy in front of the API here (the frontend's Nginx): empty → 1.
TRUST_PROXY_HOPS=
# Days the API's JSONL logs keep a line: empty → 365, 0 keeps everything.
LOG_RETENTION_DAYS=

# Accounts and the Project Studio: what staging is for.
ACCOUNTS_ENABLED=true
PROJECT_STUDIO_ENABLED=true
# Signing in: a code sent by e-mail, written to the API's log here.
MAIL_PROVIDER=log
# Your own address: every right, no end (once the code verified it).
ADMIN_EMAILS=

# The AI (objectives extraction, the planners). Off by default: the studio
# then works by hand. To try the AI, set NL2SQL_CHAT_ENABLED=true and an
# Anthropic key (preferably a separate key with its own spend limit), and
# keep the daily cap low.
NL2SQL_CHAT_ENABLED=false
ANTHROPIC_API_KEY=
NL2SQL_DAILY_BUDGET_TOTAL=60
# Where the model runs (DEPLOYMENT.md, "Model provider"). Empty: the direct
# API with the key above. bedrock: Amazon Bedrock in LLM_AWS_REGION (required,
# e.g. eu-west-3), with an IAM user's AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# vertex: Google Vertex AI, LLM_VERTEX_PROJECT_ID required, LLM_VERTEX_REGION
# default eu, with GOOGLE_APPLICATION_CREDENTIALS (a mounted key file).
LLM_PROVIDER=
LLM_AWS_REGION=
LLM_VERTEX_PROJECT_ID=
LLM_VERTEX_REGION=

# Basemap (optional, as in production).
BASEMAP_PROVIDER=
MAPTILER_KEY=
