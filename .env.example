# Local development overrides for `docker compose up --build`.
#
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (macOS/Linux)
#
# then edit the values. The root `.env` is gitignored — NEVER commit it.
# Every flag below defaults to its secure/off value when absent, so CI and
# production are unaffected by this file's existence.

# ── Corporate proxy escape hatches (build-time) ─────────────────────────────
# Set BOTH to true only when an SSL-intercepting proxy breaks apk (Alpine
# packages) and curl (MobilityData validator JAR download) during the image
# build: they turn off TLS verification. Local use only, never on a server.
# APK_INSECURE=true
# CURL_INSECURE=true

# ── AI companion (runtime) ──────────────────────────────────────────────────
# Required to see ANY AI surface (chat FAB, "Repair with AI", Ask AI...).
#ANTHROPIC_API_KEY=sk-ant-...
# Where the model runs. Empty: the direct API with the key above. For
# processing in the EU: bedrock (Amazon Bedrock, LLM_AWS_REGION required, e.g.
# eu-west-3 Paris or eu-central-1 Frankfurt; AWS default credentials) or
# vertex (Google Vertex AI, LLM_VERTEX_PROJECT_ID required, LLM_VERTEX_REGION
# default eu; Google application default credentials). See DEPLOYMENT.md,
# "Model provider".
LLM_PROVIDER=
LLM_AWS_REGION=
LLM_VERTEX_PROJECT_ID=
LLM_VERTEX_REGION=
NL2SQL_ENABLED=true
NL2SQL_CHAT_ENABLED=true
#NL2SQL_CHAT_MODEL=claude-sonnet-4-6
#NL2SQL_FREE_MESSAGES_PER_SESSION=0
# What all the server's model calls may cost over a UTC day, in euros, estimated
# from their tokens; above it the AI answers 503 AI_BUDGET_EXHAUSTED until
# midnight UTC (default 100; 0: off).
#AI_DAILY_BUDGET_EUR_TOTAL=100

# ── User accounts (runtime) ─────────────────────────────────────────────────
# Off by default: the /gtfs/auth/* routes answer 503 ACCOUNTS_DISABLED, the
# web shows no account entry and no projects.db is created. Set true to try
# signing in: a six-digit code sent by e-mail, no password (the first
# verified code creates the account). Without the paid offer below, reading
# and every modification stay open to everyone; with accounts on, the direct
# mode wants a licence (the "studio" right).
#ACCOUNTS_ENABLED=true
# How the sign-in codes (and the quote requests) are sent. The dev compose
# defaults to log: the message, code included, is written to the API's
# output (`docker compose logs api`). brevo sends it through Brevo's
# transactional API with MAIL_API_KEY and MAIL_FROM; memory keeps it in the
# process (tests). Never commit a key.
#MAIL_PROVIDER=log
# Your own address(es), comma-separated: once verified by a sign-in code,
# every right without an end and without a per-account AI cap.
#ADMIN_EMAILS=you@example.org
# The dev compose passes MAIL_PROVIDER and ADMIN_EMAILS above; the settings
# below (brevo's key and sender, the paid offer, Stripe) reach the API only
# from GTFS-EXPRESS-API/.env (`npm run dev`) or a compose file that lists
# them (docker-compose.prod.yml, the staging kit).
#MAIL_API_KEY=
#MAIL_FROM=no-reply@example.org
#MAIL_FROM_NAME=GTFS Express
# The paid offer (needs ACCOUNTS_ENABLED=true): reading stays free; every
# modification (edit mode, the SQL console's writes, the assistant's fixes,
# the Change Studio, project import) needs an account
# whose licence runs: ADMIN_EMAILS, a subscription, the administrator's grant
# with its optional end date (POST /gtfs/admin/users/:id/entitlements
# { "edit": true, "studio": true, "until": "YYYY-MM-DD" }), or the free trial
# (TRIAL_DAYS, default 14, once per address; 0: none). LICENCE_PRICE_EUR_YEAR
# is the yearly price, excluding VAT, the offer shows and the payment provider
# charges (default 4900); LICENCE_LAUNCH_OFFER shows it as the launch price
# (default true), until LICENCE_LAUNCH_UNTIL (YYYY-MM-DD; empty: no end said).
# Off by default. Stripe, server side (test mode keys while
# trying it): the secret key and the prices' ids create Checkout and Customer
# Portal sessions;
# the webhook secret verifies the events sent to /gtfs/billing/webhook
# (locally: stripe listen --forward-to localhost:3004/gtfs/billing/webhook);
# BILLING_RETURN_URL is the web's address the person comes back to (default:
# the request's Origin when it is in ALLOWED_ORIGINS). Never commit a key.
#PAID_ACCESS_ENABLED=true
#TRIAL_DAYS=14
#LICENCE_PRICE_EUR_YEAR=4900
#LICENCE_PRICE_EUR_MONTH=590
#LICENCE_LAUNCH_OFFER=true
#LICENCE_LAUNCH_UNTIL=
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PRICE_PRO=price_...
#STRIPE_PRICE_TEAM=price_...
#STRIPE_PRICE_PRO_MONTHLY=price_...
#BILLING_RETURN_URL=http://localhost:3000
# Directory of projects.db, default /app/projects in the container (a
# sibling of the uploads dir, outside the session sweeper's reach). In the
# dev stack it is not a volume: `docker compose down` and recreating the api
# container lose the dev accounts.
#PROJECTS_DIR=/app/projects
# Project Studio (a network project from its reference to its validated
# deliverables, roles per account). Needs ACCOUNTS_ENABLED=true. Off by
# default: the /gtfs/projects routes answer 503 PROJECT_STUDIO_DISABLED and
# the web shows no entry. Projects, their documents, frozen versions and
# deliverables live in PROJECTS_DIR next to projects.db.
#PROJECT_STUDIO_ENABLED=true
# Sign-in code requests and checks per 15 min per IP (default 10).
#RATE_LIMIT_MAX_AUTH=10

# ── Corporate proxy: container -> api.anthropic.com (runtime, DEV ONLY) ─────
# If the chat shows "Connection error.", the API container cannot reach
# Anthropic. Behind an SSL-INTERCEPTING (transparent) proxy:
#NODE_TLS_REJECT_UNAUTHORIZED=0
# Behind an EXPLICIT proxy (Node 24 routes fetch through it):
#NODE_USE_ENV_PROXY=1
#HTTPS_PROXY=http://proxy.corp:8080
#NO_PROXY=localhost,127.0.0.1,api
